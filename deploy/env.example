# Loaded by the systemd units. Keep chmod 600 (holds SNORE_TOKEN).
DATA_DIR=/home/pi/snore-data
MODEL_PATH=/home/pi/snore-tracker/models/yamnet.tflite
# ALSA capture device, from `arecord -L` (e.g. plughw:CARD=Device,DEV=0)
SNORE_MIC=default

SNORE_API=https://fitness.epetersons.com/api/snore
SNORE_TOKEN=

# Tuning (defaults shown)
SNORE_THRESHOLD=0.5
MIN_EVENT_MINUTES=2
MAX_GAP_MINUTES=1
DB_OFFSET=0
LOUD_DB=-20
# 1 = keep full-night audio after analysis (threshold tuning only)
KEEP_AUDIO=0

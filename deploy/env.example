# Loaded by the systemd units. Keep chmod 600 (holds SNORE_TOKEN, DEPLOY_TOKEN).
DATA_DIR=/home/pi/snore-data
MODEL_PATH=/home/pi/snore-tracker/models/yamnet.tflite
# ALSA capture device. "snoop" is the shared dsnoop PCM from deploy/asound.conf.
SNORE_MIC=snoop
# Card the web UI's gain slider controls (`arecord -l`, the word in [brackets])
SNORE_CARD=Device

SNORE_API=https://fitness.epetersons.com/api/snore
SNORE_TOKEN=

# Bearer token for POST /api/deploy (n8n "Deploy: snore-tracker"): openssl rand -hex 32
DEPLOY_TOKEN=

# Must match the watch
LOCAL_TZ=America/Chicago

# Tuning (defaults shown)
# The web UI's value (~/snore-data/settings.json) wins over this
SNORE_THRESHOLD=0.5
MIN_EVENT_MINUTES=2
MAX_GAP_MINUTES=1
DB_OFFSET=0
LOUD_DB=-20
# 1 = keep full-night audio after analysis (threshold tuning only)
KEEP_AUDIO=0

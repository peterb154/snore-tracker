[Unit]
Description=Snore tracker: stop recording, analyze the night, post to garmin_connect
# Starting this stops the recorder first, then waits for it to exit.
Conflicts=snore-record.service
After=snore-record.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
EnvironmentFile=/home/pi/snore-tracker/.env
Nice=10
ExecStart=/home/pi/snore-tracker/.venv/bin/snore-analyze
ExecStart=/home/pi/snore-tracker/.venv/bin/snore-post
